{
  "$id": "https://github.com/Daisuke134/life-manager/runtime/loop/loop.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "properties": {
          "cadence": {
            "required": [
              "keep_alive"
            ]
          }
        },
        "required": [
          "runtime_timeout_seconds"
        ]
      }
    }
  ],
  "dependentRequired": {
    "adapter": [
      "command"
    ],
    "command": [
      "adapter"
    ]
  },
  "properties": {
    "adapter": {
      "enum": [
        "exec",
        "python"
      ],
      "type": "string"
    },
    "admission_class": {
      "enum": [
        "borrow",
        "revenue"
      ],
      "type": "string"
    },
    "browser_owner": {
      "additionalProperties": false,
      "properties": {
        "cdp_port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "profile": {
          "pattern": "^~/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+",
          "type": "string"
        }
      },
      "required": [
        "cdp_port",
        "profile"
      ],
      "type": "object"
    },
    "cadence": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "calendar_interval": {
              "type": [
                "object",
                "array"
              ]
            }
          },
          "required": [
            "calendar_interval"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "keep_alive": {
              "const": true
            }
          },
          "required": [
            "keep_alive"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "run_at_load": {
              "const": true
            }
          },
          "required": [
            "run_at_load"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "start_interval_seconds": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "start_interval_seconds"
          ],
          "type": "object"
        }
      ]
    },
    "cleanup": {
      "additionalProperties": false,
      "properties": {
        "max_age_days": {
          "minimum": 1,
          "type": "integer"
        },
        "max_runs": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_age_days",
        "max_runs"
      ],
      "type": "object"
    },
    "coalesce_queued_wakes": {
      "type": "boolean"
    },
    "coalesce_reserved_wakes": {
      "type": "boolean"
    },
    "command": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "domain": {
      "enum": [
        "earn",
        "financial",
        "growth",
        "mental",
        "physical",
        "system"
      ],
      "type": "string"
    },
    "effect_class": {
      "enum": [
        "account_mutation",
        "application",
        "message",
        "money",
        "none",
        "publish",
        "trade"
      ],
      "type": "string"
    },
    "entrypoint": {
      "minLength": 1,
      "pattern": "^(?!/)(?!(?:\\./)*\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "type": "string"
    },
    "label": {
      "pattern": "^ai\\.anicca\\..*$",
      "type": "string"
    },
    "log_root": {
      "pattern": "^~/.+",
      "type": "string"
    },
    "loop_id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "priority": {
      "enum": [
        "critical_paid",
        "revenue",
        "support"
      ],
      "type": "string"
    },
    "provider_route": {
      "enum": [
        "deterministic",
        "shared-agent-runner"
      ],
      "type": "string"
    },
    "resource_class": {
      "enum": [
        "agent",
        "browser",
        "deterministic"
      ],
      "type": "string"
    },
    "runtime_timeout_seconds": {
      "minimum": 1,
      "type": "integer"
    },
    "state_root": {
      "pattern": "^~/.+",
      "type": "string"
    }
  },
  "required": [
    "loop_id",
    "cadence",
    "cleanup",
    "domain",
    "effect_class",
    "entrypoint",
    "label",
    "log_root",
    "provider_route",
    "state_root"
  ],
  "title": "Life Manager loop.json",
  "type": "object"
}
