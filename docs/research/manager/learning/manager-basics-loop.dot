digraph G {rankdir=TB;bgcolor="white";node[shape=box,style="rounded,filled",fillcolor="#eef4fa",fontname="Noto Sans CJK JP",fontsize=16,margin="0.2,0.16"];edge[color="#3c6285"];A[label="公開統計・運営記録"];B[label="現在の状態と不確実性"];C[label="人口・行動・環境のモデル"];D[label="変更候補を同じ制約で比較"];E[label="権限のある環境で実行・確認"];F[label="結果・集団別影響・費用を評価"];A->B->C->D->E->F;F->B[label="予測と判断を更新",fontname="Noto Sans CJK JP",fontsize=13];}
