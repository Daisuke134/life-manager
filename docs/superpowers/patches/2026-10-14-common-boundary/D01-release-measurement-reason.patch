+
+@pytest.mark.parametrize("message,expected", [
+    ("dependency bundle unavailable", "dependency_bundle_unavailable"),
+    ("fixture-sensitive-value", "unclassified"),
+])
+def test_release_capacity_error_reports_safe_measurement_reason(
+    monkeypatch, tmp_path, capsys, message, expected,
+):
+    guard = load_guard()
+    monkeypatch.setattr(guard, "release_capacity_bytes",
+                        lambda *_args: (_ for _ in ()).throw(ValueError(message)))
+    assert guard.main(["--release-capacity", str(tmp_path), "a" * 40,
+                       str(tmp_path), "node", "npm"]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    payload = json.loads(captured.err)
+    assert payload["reason"] == "release_capacity_measurement_failed"
+    assert payload["measurement_reason"] == expected
+    assert "fixture-sensitive-value" not in captured.err
