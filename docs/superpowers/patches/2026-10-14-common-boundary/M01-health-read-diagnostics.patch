 )
 
+
+
+HEALTH_READ_DIAGNOSTIC_SCHEMA = "lm-loop.health-read-diagnostic.v1"
+HEALTH_READ_STAGES = frozenset({
+    "runtime_snapshot", "admission_fences", "resolved_receipts", "launchd_list",
+    "launchd_disabled", "runtime_journal", "status_projection", "storage_snapshot",
+    "health_projection", "health_subprocess",
+})
+
+
+def sanitize_health_read_diagnostic(value: object, *, allowed_loop_ids: set[str]) -> dict | None:
+    if not isinstance(value, dict) or value.get("schema_version") != HEALTH_READ_DIAGNOSTIC_SCHEMA:
+        return None
+    if not isinstance(value.get("stage"), str) or value["stage"] not in HEALTH_READ_STAGES:
+        return None
+    if value.get("source") not in ("health_cli", "observer_subprocess"):
+        return None
+    if value.get("event") not in ("start", "timeout", "complete", "error"):
+        return None
+    loop_id = value.get("loop_id")
+    if loop_id is not None and (not isinstance(loop_id, str) or loop_id not in allowed_loop_ids):
+        return None
+    for name, positive in (("elapsed_seconds", False), ("budget_seconds", True)):
+        number = value.get(name)
+        if (isinstance(number, bool) or not isinstance(number, (int, float))
+                or number < 0 or (positive and number == 0)):
+            return None
+        try:
+            if not math.isfinite(number):
+                return None
+        except OverflowError:
+            return None
+    return {name: value.get(name) for name in (
+        "schema_version", "source", "event", "stage", "loop_id",
+        "elapsed_seconds", "budget_seconds",
+    )}
 
 class HealthTimeout(TimeoutError):
     pass
