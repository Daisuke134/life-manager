+    def test_health_snapshot_timeout_reports_exact_read_stage(self):
+        output, diagnostic_output = io.StringIO(), io.StringIO()
+        loop_id = next(iter(json.loads((ROOT / "config/loop-registry.json").read_text())["loops"]))
+        def fail_snapshot(*_args, **kwargs):
+            observer = kwargs.get("stage_observer")
+            if observer is not None:
+                observer("runtime_journal", loop_id)
+            raise health.HealthTimeout()
+        with (patch.object(lm_loop, "snapshot", side_effect=fail_snapshot),
+              redirect_stdout(output), redirect_stderr(diagnostic_output)):
+            self.assertEqual(lm_loop_main(["health", "--json"]), 1)
+        value = json.loads(output.getvalue())
+        self.assertEqual(value["summary"]["telemetry_gap"], len(value["jobs"]))
+        records = [json.loads(line) for line in diagnostic_output.getvalue().splitlines()]
+        self.assertTrue(records, "missing bounded read diagnostic")
+        self.assertEqual(records[-1]["event"], "timeout")
+        self.assertEqual(records[-1]["stage"], "runtime_journal")
+        self.assertEqual(records[-1]["loop_id"], loop_id)
+
+    def test_storage_time_consumption_reports_projection_timeout(self):
+        output, diagnostic_output = io.StringIO(), io.StringIO()
+        clock = {"now": 100.0}
+        def slow_storage():
+            clock["now"] = 131.0
+            return None
+        with (patch.object(lm_loop, "snapshot", return_value=[self.status_row("one")]),
+              patch.object(lm_loop, "read_storage_snapshot", side_effect=slow_storage),
+              patch("runtime.loop.lm_loop.time.monotonic", side_effect=lambda: clock["now"]),
+              patch("runtime.loop.health.monotonic", side_effect=lambda: clock["now"]),
+              redirect_stdout(output), redirect_stderr(diagnostic_output)):
+            self.assertEqual(lm_loop_main(["health", "--json"]), 1)
+        records = [json.loads(line) for line in diagnostic_output.getvalue().splitlines()]
+        self.assertEqual([record["stage"] for record in records if record["event"] == "start"],
+                         ["runtime_snapshot", "storage_snapshot", "health_projection"])
+        self.assertTrue(records, "missing bounded read diagnostic")
+        self.assertEqual(records[-1]["event"], "timeout")
+        self.assertEqual(records[-1]["stage"], "health_projection")
+        self.assertEqual(records[-1]["elapsed_seconds"], 31.0)
+        self.assertEqual(json.loads(output.getvalue())["summary"]["telemetry_gap"], 1)
