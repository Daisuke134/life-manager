+def _forward_health_read_diagnostics(stderr, *, allowed_loop_ids: set[str]) -> dict | None:
+    if isinstance(stderr, bytes):
+        stderr = stderr.decode("utf-8", errors="replace")
+    if not isinstance(stderr, str):
+        return None
+    last = None
+    count = 0
+    for line in stderr[-4096:].splitlines():
+        if len(line) > 1024:
+            continue
+        try:
+            candidate = json.loads(line)
+        except ValueError:
+            continue
+        diagnostic = sanitize_health_read_diagnostic(candidate, allowed_loop_ids=allowed_loop_ids)
+        if diagnostic is None:
+            continue
+        print(json.dumps(diagnostic, sort_keys=True), file=sys.stderr)
+        last = diagnostic
+        count += 1
+        if count == 4:
+            break
+    return last
+
