+    def test_snapshot_loader_keeps_only_valid_bounded_read_diagnostics(self):
+        document = health_document()
+        good = {"schema_version": "lm-loop.health-read-diagnostic.v1", "source": "health_cli",
+                "event": "timeout", "stage": "runtime_journal",
+                "loop_id": document["jobs"][0]["job_id"], "elapsed_seconds": 30.0,
+                "budget_seconds": 30.0, "raw_secret": "fixture-sensitive-value"}
+        bad_stage = {**good, "stage": "fixture-sensitive-value"}
+        bad_number = {**good, "elapsed_seconds": float("nan")}
+        huge_number = {**good, "elapsed_seconds": 10 ** 400}
+        bool_number = {**good, "elapsed_seconds": True}
+        completed = SimpleNamespace(returncode=1, stdout=json.dumps(document),
+            stderr="raw fixture-sensitive-value\n" + "\n".join(
+                json.dumps(row) for row in [bad_stage, bad_number, huge_number, bool_number, *([good] * 6)]))
+        output = io.StringIO()
+        with (patch("runtime.loop.health_observer.subprocess.run", return_value=completed),
