// Copy to Configs/Production.xcconfig and fill values from private state.
ANICCA_PROXY_BASE_URL = https://api.example.invalid
INFOPLIST_KEY_ANICCA_PROXY_BASE_URL = $(ANICCA_PROXY_BASE_URL)
REVENUECAT_API_KEY = REPLACE_ME
REVENUECAT_ENTITLEMENT_ID = REPLACE_ME
REVENUECAT_CUSTOMER_CENTER_ID = REPLACE_ME
INFOPLIST_KEY_REVENUECAT_API_KEY = $(REVENUECAT_API_KEY)
INFOPLIST_KEY_REVENUECAT_ENTITLEMENT_ID = $(REVENUECAT_ENTITLEMENT_ID)
INFOPLIST_KEY_REVENUECAT_CUSTOMER_CENTER_ID = $(REVENUECAT_CUSTOMER_CENTER_ID)
RESET_ON_LAUNCH = NO
INFOPLIST_KEY_RESET_ON_LAUNCH = $(RESET_ON_LAUNCH)
MIXPANEL_TOKEN = REPLACE_ME
INFOPLIST_KEY_MIXPANEL_TOKEN = $(MIXPANEL_TOKEN)
INFOPLIST_KEY_NSAlarmKitUsageDescription = Anicca uses alarms to remind you about routines.
