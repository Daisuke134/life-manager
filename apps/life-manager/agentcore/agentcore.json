{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "LifeManagerCloud",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "LifeManagerCloud"
  },
  "runtimes": [
    {
      "name": "cloud_canary",
      "description": "Disposable read-only CL00 isolation probe",
      "build": "CodeZip",
      "entrypoint": "main.js",
      "codeLocation": "agentcore/app/cloud-canary/",
      "runtimeVersion": "NODE_22",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 900
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
