#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../../.." && pwd)"
LOOP_ID="${1:-}"
ENV_FILE="${LIFE_MANAGER_MARKETING_ENV_FILE:-${HOME}/.local/state/life-manager/private/marketing.env}"
# The release SHA belongs to the immutable launchd/release binding, never to
# the mutable operator-maintained marketing env file.  Keep both the value and
# absence exact across loading that file so runtime status attribution cannot
# be relabelled as a stale release.
if [ "${LIFE_MANAGER_RELEASE_SHA+x}" = x ]; then
  RELEASE_SHA_BOUND=1
  RELEASE_SHA="${LIFE_MANAGER_RELEASE_SHA}"
else
  RELEASE_SHA_BOUND=0
fi
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/load-env-file.sh"
lm_load_env_file "$ENV_FILE"
if [ "$RELEASE_SHA_BOUND" -eq 1 ]; then
  export LIFE_MANAGER_RELEASE_SHA="$RELEASE_SHA"
else
  unset LIFE_MANAGER_RELEASE_SHA
fi
lm_require_env_keys LM_POSTIZ_API_KEY

NODE_BIN="${LIFE_MANAGER_NODE:-${LIFE_MANAGER_RUNTIME_NODE:-$(command -v node || true)}}"
PYTHON_BIN="${LIFE_MANAGER_PYTHON:-${LIFE_MANAGER_RUNTIME_PYTHON:-$(command -v python3 || true)}}"
[ -n "$NODE_BIN" ] && [ -x "$NODE_BIN" ] || { printf 'mobile app loop requires node\n' >&2; exit 1; }
[ -n "$PYTHON_BIN" ] && [ -x "$PYTHON_BIN" ] || { printf 'mobile app loop requires python3\n' >&2; exit 1; }

# An immutable release binding is authoritative only when it agrees with the
# release manifest that launched this entrypoint.  Refuse a stale binding
# before the reconciliation command can inspect or resolve an external effect.
RELEASE_ROOT="${LIFE_MANAGER_REPO:-$REPO_ROOT}"
if [ "$RELEASE_SHA_BOUND" -eq 1 ] && [ -n "${LIFE_MANAGER_REPO:-}" ]; then
  RELEASE_MANIFEST="$RELEASE_ROOT/RELEASE.json"
  [ -f "$RELEASE_MANIFEST" ] || { printf 'mobile app installed release manifest is unavailable\n' >&2; exit 2; }
  INSTALLED_RELEASE_SHA="$("$NODE_BIN" -e 'const fs=require("node:fs"); const value=JSON.parse(fs.readFileSync(process.argv[1], "utf8")); if(typeof value.sha!=="string" || !/^[a-f0-9]{40}$/.test(value.sha)) process.exit(2); process.stdout.write(value.sha);' "$RELEASE_MANIFEST")" || {
    printf 'mobile app installed release manifest is invalid\n' >&2
    exit 2
  }
  if [ "$RELEASE_SHA" != "$INSTALLED_RELEASE_SHA" ]; then
    printf 'mobile app release binding does not match installed release\n' >&2
    exit 2
  fi
fi

if ! POSTIZ_API_KEY="$LM_POSTIZ_API_KEY" "$PYTHON_BIN" \
  "$SCRIPT_DIR/mobile-postiz-provider-reconcile.py" \
  --auto-owner "$LOOP_ID" --resolve >&2
then
  case "${LIFE_MANAGER_OCCURRENCE_ID:-}" in
    "${LOOP_ID}":*)
      printf "mobile app prior-effect reconciliation unresolved; continuing separately admitted occurrence: %s\n" "$LOOP_ID" >&2
      ;;
    *)
      printf "mobile app prior-effect reconciliation deferred: %s\n" "$LOOP_ID" >&2
      exit 75
      ;;
  esac
fi
IFS=$'\t' read -r RUNNER ACTION PRODUCT_ID PRODUCT_ORIGIN PRODUCT_WORKSPACE_REL < <("$NODE_BIN" "$SCRIPT_DIR/mobile-app-command.js" "$LOOP_ID")
[ -n "$RUNNER" ] && [ -n "$ACTION" ] && [ -n "$PRODUCT_ID" ] && [ -n "$PRODUCT_ORIGIN" ] && [ -n "$PRODUCT_WORKSPACE_REL" ] || {
  printf 'mobile app loop resolution failed: %s\n' "$LOOP_ID" >&2
  exit 2
}
export LIFE_MANAGER_MOBILE_PRODUCT_ID="$PRODUCT_ID"
export LIFE_MANAGER_MOBILE_PRODUCT_ORIGIN="$PRODUCT_ORIGIN"
export LIFE_MANAGER_MOBILE_PRODUCT_WORKSPACE_REL="$PRODUCT_WORKSPACE_REL"

RESULT_CAPTURE="$(mktemp "${TMPDIR:-/tmp}/lm-mobile-result.XXXXXX")"
trap 'rm -f -- "$RESULT_CAPTURE"' EXIT
# The Postiz adapter clears this proof immediately before its first upload;
# keep it through publisher-local validation so pre-dispatch failures stay provable.
set +e
"$PYTHON_BIN" "$REPO_ROOT/runtime/run-with-timeout.py" --grace-seconds 10 1200 \
  "$NODE_BIN" "$RUNNER" "$ACTION" | tee "$RESULT_CAPTURE"
PIPE_STATUSES=("${PIPESTATUS[@]}")
set -e
RUNNER_STATUS="${PIPE_STATUSES[0]}"
TEE_STATUS="${PIPE_STATUSES[1]}"
if [ "$TEE_STATUS" -ne 0 ]; then
  exit "$TEE_STATUS"
fi
if [ "$RUNNER_STATUS" -eq 0 ] && [ -n "${LIFE_MANAGER_RESULT_HINT_PATH:-}" ]; then
  if ! "$NODE_BIN" "$SCRIPT_DIR/mobile-effect-result.js" "$RESULT_CAPTURE" --require-origin-occurrence; then
    printf 'mobile app exact result hint unavailable: %s\n' "$LOOP_ID" >&2
  fi
fi
exit "$RUNNER_STATUS"
