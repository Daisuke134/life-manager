{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain flip candidate review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "selected_domain",
    "listing_price_eur",
    "minimum_accepted_price_eur",
    "rights_risk",
    "reason",
    "evidence_refs"
  ],
  "properties": {
    "action": {"type": "string", "enum": ["register", "skip"]},
    "selected_domain": {"type": "string", "pattern": "^[a-z0-9-]{1,63}\\.si$"},
    "listing_price_eur": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "minimum_accepted_price_eur": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "rights_risk": {"type": "string", "enum": ["clear", "possible_conflict", "unverified"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 512}}
  }
}
