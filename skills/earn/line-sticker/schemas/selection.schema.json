{
  "type": "object",
  "additionalProperties": false,
  "required": ["order", "main", "tab", "rejected", "listing", "tags", "taste_id", "character_category_id", "campaign_value"],
  "properties": {
    "order": {"type": "array", "items": {"type": "string"}},
    "main": {"type": "string"},
    "tab": {"type": "string"},
    "rejected": {"type": "array", "items": {"type": "string"}},
    "taste_id": {"type": "string"},
    "character_category_id": {"type": "string"},
    "campaign_value": {"type": ["string", "null"]},
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ja", "en"],
          "properties": {"ja": {"type": "string"}, "en": {"type": "string"}}
        },
        "description": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ja", "en"],
          "properties": {"ja": {"type": "string"}, "en": {"type": "string"}}
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sticker_number", "tags"],
        "properties": {
          "sticker_number": {"type": "string", "pattern": "^(0[1-9]|1[0-9]|2[0-4])$"},
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
