        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "start", "seconds", "plays"],
        "properties": {
          "id": {"type": "string"},
          "prompt": {"type": "string"},
          "start": {"type": ["number", "null"]},
          "seconds": {"type": ["number", "null"]},
          "plays": {"type": ["integer", "null"]}
