          "required": ["ja", "en"],
          "properties": {"ja": {"type": "string"}, "en": {"type": "string"}}
        },
        "description": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ja", "en"],
          "properties": {"ja": {"type": "string"}, "en": {"type": "string"}}
        }
      }
