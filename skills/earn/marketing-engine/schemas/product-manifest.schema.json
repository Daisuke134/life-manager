{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anicca.ai/schemas/marketing/product-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","product_id","type","live_status","destination_url","price","approved_claims","cta","conversion_events","revenue_events","margin_rule","audiences","metric_adapters","primary_metric","attribution_method"],
  "properties": {
    "schema_version": {"const": "marketing.product.v1"},
    "product_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["ios_app", "ebook", "web_app", "marketplace_agent"]},
    "live_status": {"type": "string", "minLength": 1},
    "destination_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "price": {"type":"object","additionalProperties":false,"required":["amount","currency","basis"],"properties":{"amount":{"type":"number","minimum":0},"currency":{"type":"string","minLength":3},"basis":{"type":"string","minLength":1}}},
    "approved_claims": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "cta": {"type":"string","minLength":1},
    "conversion_events": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "revenue_events": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "margin_rule": {"type":"string","minLength":1},
    "audiences": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "metric_adapters": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "primary_metric": {"type":"string","minLength":1},
    "attribution_method": {"type":"string","minLength":1},
    "distribution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["economic_role","related_loop_id","buyer_problem","offer_snapshot","allowed_channel_accounts","destination","outcome_sources"],
      "properties": {
        "economic_role": {"type": "string", "minLength": 1},
        "related_loop_id": {"type": "string", "minLength": 1},
        "buyer_problem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement","source_ref","validation_status"],
          "properties": {
            "statement": {"type": "string", "minLength": 1},
            "source_ref": {"type": "string", "minLength": 1},
            "validation_status": {"type": "string", "minLength": 1}
          }
        },
        "offer_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seller_agent_id","published_version","observed_at","latest_public_readback_at","price_status","frozen","trial_days","price_tiers","source_refs","source_conflicts"],
          "properties": {
            "seller_agent_id": {"type": "string", "minLength": 1},
            "published_version": {"type": "string", "minLength": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "latest_public_readback_at": {"type": "string", "format": "date-time"},
            "price_status": {"enum": ["current_verified", "stale_unverified"]},
            "frozen": {"type": "boolean"},
            "trial_days": {"type": "integer", "minimum": 0},
            "price_tiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["period","amount","currency","cap"],
                "properties": {
                  "period": {"type": "string", "minLength": 1},
                  "amount": {"type": "number", "minimum": 0},
                  "currency": {"type": "string", "minLength": 3},
                  "cap": {"type": "integer", "minimum": 1}
                }
              }
            },
            "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "source_conflicts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_ref","detail","resolution"],
                "properties": {
                  "source_ref": {"type": "string", "minLength": 1},
                  "detail": {"type": "string", "minLength": 1},
                  "resolution": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "allowed_channel_accounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["account_ref","platform","native_handle","publisher_integration_id","campaign_token","last_observed_at","operational_status","publish_enabled"],
            "properties": {
              "account_ref": {"type": "string", "minLength": 1},
              "platform": {"enum": ["instagram","tiktok","youtube"]},
              "native_handle": {"type": "string", "minLength": 1},
              "publisher_integration_id": {"type": "string", "minLength": 1},
              "campaign_token": {"type": "string", "minLength": 1},
              "last_observed_at": {"type": "string", "format": "date-time"},
              "operational_status": {"type": "string", "minLength": 1},
              "publish_enabled": {"type": "boolean"}
            }
          }
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url","campaign_token","per_slot_attribution","source_ref"],
          "properties": {
            "url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "campaign_token": {"type": "string", "minLength": 1},
            "per_slot_attribution": {"type": "string", "minLength": 1},
            "source_ref": {"type": "string", "minLength": 1}
          }
        },
        "outcome_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric","source","status","attribution_granularity","source_ref"],
            "properties": {
              "metric": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "attribution_granularity": {"type": "string", "minLength": 1},
              "source_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "marketplace_agent"}}, "required": ["type"]},
      "then": {"required": ["distribution_profile"]}
    }
  ]
}
