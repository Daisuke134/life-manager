{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anicca.ai/schemas/marketing/product-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","product_id","type","live_status","destination_url","price","approved_claims","cta","conversion_events","revenue_events","margin_rule","audiences","metric_adapters","primary_metric","attribution_method"],
  "properties": {
    "schema_version": {"const": "marketing.product.v1"},
    "product_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["ios_app", "ebook", "web_app"]},
    "live_status": {"type": "string", "minLength": 1},
    "destination_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "price": {"type":"object","additionalProperties":false,"required":["amount","currency","basis"],"properties":{"amount":{"type":"number","minimum":0},"currency":{"type":"string","minLength":3},"basis":{"type":"string","minLength":1}}},
    "approved_claims": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "cta": {"type":"string","minLength":1},
    "conversion_events": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "revenue_events": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "margin_rule": {"type":"string","minLength":1},
    "audiences": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "metric_adapters": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "primary_metric": {"type":"string","minLength":1},
    "attribution_method": {"type":"string","minLength":1}
  }
}
