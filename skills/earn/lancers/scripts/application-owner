#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$HOME/.local/share/life-manager/venv/bin/python}"
STATE_ROOT="${LIFE_MANAGER_STATE_ROOT:?LIFE_MANAGER_STATE_ROOT is required}"
if [[ ! -x "$PYTHON" ]]; then
  echo "Life Manager runtime Python is missing; run scripts/bootstrap.sh first" >&2
  exit 69
fi
exec "$PYTHON" "$ROOT/skills/earn/lancers/scripts/application_loop.py" \
  --json --state-path "$STATE_ROOT/application.json" "$@"
