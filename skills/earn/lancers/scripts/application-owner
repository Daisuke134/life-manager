#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$HOME/.local/share/life-manager/venv/bin/python}"
STATE_ROOT="${LIFE_MANAGER_STATE_ROOT:?LIFE_MANAGER_STATE_ROOT is required}"
if [[ ! -x "$PYTHON" ]]; then
  echo "Life Manager runtime Python is missing; run scripts/bootstrap.sh first" >&2
  exit 69
fi

set +e
OUTPUT="$("$PYTHON" "$ROOT/skills/earn/lancers/scripts/application_loop.py" \
  --json --state-path "$STATE_ROOT/application.json" "$@")"
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

# These two errors happen before application_tick's profile/account lock can reach a provider
# mutation (same boundary as storefront_offer.py's account_unavailable/account_lock_busy).
# Preserve a durable hint only for that exact boundary; submission/readback errors stay fenced.
if [[ "$STATUS" -ne 0 && -n "${LIFE_MANAGER_RESULT_HINT_PATH:-}" ]] \
  && printf '%s' "$OUTPUT" | /usr/bin/python3 -c 'import json,sys
try:
    value=json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if isinstance(value,dict) and value.get("ok") is False and value.get("error") in {"account_unavailable","account_lock_busy"} else 1)' ; then
  hint="$LIFE_MANAGER_RESULT_HINT_PATH"
  temporary="$hint.tmp.$$"
  (umask 077; printf '%s\n' '{"status":"pre_effect_failure","effect":0}' > "$temporary")
  chmod 600 "$temporary"
  mv -f "$temporary" "$hint"
fi
exit "$STATUS"
