#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$HOME/.local/share/life-manager/venv/bin/python}"
STATE_ROOT="${LIFE_MANAGER_STATE_ROOT:?LIFE_MANAGER_STATE_ROOT is required}"

if [[ ! -x "$PYTHON" ]]; then
  echo "storefront-owner: managed Python is unavailable: $PYTHON" >&2
  exit 69
fi

# The step below can create a portfolio. Drop the host's pre-spawn hint first, as mercor's
# application-owner does, so a failed pass stays fenced unless the account preflight rewrites it.
if [[ -n "${LIFE_MANAGER_RESULT_HINT_PATH:-}" ]]; then
  rm -f "$LIFE_MANAGER_RESULT_HINT_PATH"
fi

set +e
OUTPUT="$("$PYTHON" "$ROOT/skills/earn/lancers/scripts/storefront_offer.py" \
  --owner-run \
  --state-path "$STATE_ROOT/application.json" \
  "$@")"
STATUS=$?
set -e
printf '%s\n' "$OUTPUT"

# storefront_offer reaches a provider mutation only after logged_in=True, so a failure that still
# reports logged_in=false (account_unavailable, account_lock_busy, browser startup) is pre-effect.
# Restore the durable hint only for that boundary; anything after login remains fenced.
if [[ "$STATUS" -ne 0 && -n "${LIFE_MANAGER_RESULT_HINT_PATH:-}" ]] \
  && printf '%s' "$OUTPUT" | /usr/bin/python3 -c 'import json,sys
try:
    value=json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if isinstance(value,dict) and value.get("ok") is False and value.get("logged_in") is False else 1)' ; then
  hint="$LIFE_MANAGER_RESULT_HINT_PATH"
  temporary="$hint.tmp.$$"
  (umask 077; printf '%s\n' '{"status":"pre_effect_failure","effect":0}' > "$temporary")
  chmod 600 "$temporary"
  mv -f "$temporary" "$hint"
fi
exit "$STATUS"
