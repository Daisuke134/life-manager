#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$HOME/.local/share/life-manager/venv/bin/python}"
STATE_ROOT="${LIFE_MANAGER_STATE_ROOT:?LIFE_MANAGER_STATE_ROOT is required}"
PAID_OUTPUT="$STATE_ROOT/paid-latest.json"

if [[ ! -x "$PYTHON" ]]; then
  echo "paid-owner: managed Python is unavailable: $PYTHON" >&2
  exit 69
fi

set +e
"$PYTHON" "$ROOT/skills/_shared/marketplace-core/scripts/paid_kernel.py" \
  --provider-adapter "$ROOT/skills/earn/lancers/scripts/paid_adapter.py" \
  --state-root "$STATE_ROOT/paid" \
  --output "$PAID_OUTPUT" \
  -- \
  --account-id keiodaisuke \
  --state-path "$STATE_ROOT/application.json"
KERNEL_RC=$?
set -e

if (( KERNEL_RC != 0 )); then
  exit "$KERNEL_RC"
fi

set +e
"$PYTHON" "$ROOT/skills/earn/lancers/scripts/lane_report.py" \
  --lane paid \
  --state-path "$STATE_ROOT/contracts.json" \
  "$@"
REPORT_RC=$?
set -e

OCCURRENCE="${LIFE_MANAGER_OCCURRENCE_ID:-}"
if [[ -n "$OCCURRENCE" ]]; then
  set +e
  "$PYTHON" "$ROOT/skills/_shared/marketplace-core/scripts/reconcile_paid_no_effect.py" \
    --state-root "$STATE_ROOT" --owner lancers-revenue-paid \
    --occurrence "$OCCURRENCE" --resolve
  RECONCILE_RC=$?
  set -e
  if (( RECONCILE_RC != 0 )); then
    echo "paid-owner: zero-effect occurrence was not reconciled: $OCCURRENCE" >&2
  fi
fi

exit "$REPORT_RC"
