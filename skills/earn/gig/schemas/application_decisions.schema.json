{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gig application planner decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "business_class",
          "reason_codes",
          "proposal_text",
          "price_jpy",
          "deliver_date",
          "work_frequency",
          "weekly_hours_min",
          "weekly_hours_max"
        ],
        "properties": {
          "request_id": {"type": "string", "pattern": "^(?:[0-9]+|[0-7][0-9A-HJKMNP-TV-Z]{25})$"},
          "business_class": {"enum": ["submit_required", "hard_prohibited"]},
          "reason_codes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "proposal_text": {"type": ["string", "null"], "minLength": 200, "maxLength": 3000},
          "price_jpy": {"type": ["integer", "null"], "minimum": 1},
          "deliver_date": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "work_frequency": {
            "type": ["string", "null"],
            "enum": ["WEEK_ONE", "WEEK_TWO", "WEEK_THREE", "WEEK_FOUR", "WEEK_FIVE", "BIWEEKLY", "MONTH_ONE", null]
          },
          "weekly_hours_min": {"type": ["integer", "null"], "minimum": 0},
          "weekly_hours_max": {"type": ["integer", "null"], "minimum": 0}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "request_id": {"pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"}
              }
            },
            "then": {
              "required": ["work_frequency", "weekly_hours_min", "weekly_hours_max"],
              "properties": {
                "work_frequency": {
                  "type": "string",
                  "enum": ["WEEK_ONE", "WEEK_TWO", "WEEK_THREE", "WEEK_FOUR", "WEEK_FIVE", "BIWEEKLY", "MONTH_ONE"]
                },
                "weekly_hours_min": {"type": "integer", "minimum": 0},
                "weekly_hours_max": {"type": "integer", "minimum": 0}
              }
            },
            "else": {
              "required": ["work_frequency", "weekly_hours_min", "weekly_hours_max"],
              "properties": {
                "work_frequency": {"const": null},
                "weekly_hours_min": {"const": null},
                "weekly_hours_max": {"const": null}
              }
            }
          }
        ]
      }
    }
  }
}
