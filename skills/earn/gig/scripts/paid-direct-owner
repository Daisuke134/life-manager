#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${HF_GIG_PYTHON:-$(command -v python3)}"
GIG_ROOT="${GIG_STATE_DIR:-$HOME/gig}"
export CLOAK_TARGET_OWNERS_FILE="${CLOAK_TARGET_OWNERS_FILE:-$HOME/.cloak/vault/gig-target-owners.json}"

COMMAND=("$PYTHON" "$ROOT/skills/earn/gig/scripts/gig_disk_guard.py" \
  "$PYTHON" "$ROOT/skills/earn/gig/scripts/paid_direct.py" \
  --require-paid-handoff \
  --coconala-paid-adapter "$ROOT/skills/earn/gig/scripts/coconala_paid_adapter.py" \
  --output "$GIG_ROOT/evidence/paid-direct-live/latest.json" \
  --evidence-dir "$GIG_ROOT/evidence/paid-direct-live" \
  --projects-root "$GIG_ROOT/projects" \
  --lock-file "$GIG_ROOT/.paid-direct.lock" \
  --cdp-lock-dir "$GIG_ROOT/.cdp-gig.lock")

if [[ -n "${LIFE_MANAGER_BROWSER_IDENTITY:-}" ]]; then
  # CFO money readback (A8.7): this owner already holds Coconala's browser identity and a
  # 15-minute cadence, so it refreshes the official revenue history at most hourly under a
  # short lease of its own.  It never delays Paid work past 30s and never changes its result.
  READBACK=("$PYTHON" "$ROOT/skills/earn/gig/scripts/coconala_cfo_financial_readback.py" \
    --output "${COCONALA_CFO_READBACK:-$HOME/.local/state/life-manager/coconala/cfo-financial-readback.json}" \
    --min-interval-seconds 3600)
  if "${READBACK[@]}" --check-due >/dev/null 2>&1; then
    BROWSER_WAIT_SECONDS=30 "$ROOT/skills/browser/with-browser.sh" \
      "$LIFE_MANAGER_BROWSER_IDENTITY" -- "${READBACK[@]}" >&2 \
      || echo "paid-direct-owner: coconala CFO readback not refreshed" >&2
  fi
  exec "$ROOT/skills/browser/with-browser.sh" \
    "$LIFE_MANAGER_BROWSER_IDENTITY" -- "${COMMAND[@]}" "$@"
fi
exec "${COMMAND[@]}" "$@"
