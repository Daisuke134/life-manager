#!/usr/bin/env zsh
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$HOME/.local/share/life-manager/venv/bin/python}"
LEASE_PYTHON="${LIFE_MANAGER_LEASE_PYTHON:-/usr/bin/python3}"
STATE_ROOT="${LIFE_MANAGER_STATE_ROOT:?LIFE_MANAGER_STATE_ROOT is required}"
LEASE_SCRIPT="$ROOT/skills/browser/scripts/cdp_context_lease.py"
TASK="mercor-revenue-application"
CDP="http://127.0.0.1:9222"
LEASE_JSON="$STATE_ROOT/browser-lease.json"
WRITEBACK_JSON="$STATE_ROOT/session-writeback.json"
AUTH_READBACK_JSON="$STATE_ROOT/auth-readback.json"
EMAIL_AUTH_JSON="$STATE_ROOT/email-auth.json"
LEASE_TOKEN=""
LEASE_GENERATION=""

[[ -x "$PYTHON" ]] || { print -u2 "mercor application owner: managed Python unavailable"; exit 69; }
[[ -x "$LEASE_PYTHON" ]] || { print -u2 "mercor application owner: lease Python unavailable"; exit 69; }
mkdir -p "$STATE_ROOT"; chmod 700 "$STATE_ROOT"
LEGACY_ROOT="${STATE_ROOT:h}"
if [[ ! -f "$STATE_ROOT/applications.jsonl" && -f "$LEGACY_ROOT/applications.jsonl" ]]; then
  /bin/cp "$LEGACY_ROOT/applications.jsonl" "$STATE_ROOT/applications.jsonl"
  chmod 600 "$STATE_ROOT/applications.jsonl"
fi
if [[ ! -f "$STATE_ROOT/resume-state.json" && -f "$LEGACY_ROOT/resume-state.json" ]]; then
  /bin/cp "$LEGACY_ROOT/resume-state.json" "$STATE_ROOT/resume-state.json"
  chmod 600 "$STATE_ROOT/resume-state.json"
fi
export CLOAK_CDP_BASE_URL="$CDP"
export CLOAK_SESSION_VAULT_FILE="$HOME/.cloak/vault/job-search-daily/auth-state.json"
export CLOAK_SESSION_VAULT_WRITEBACK_FILE="$STATE_ROOT/auth-overlay.json"
export CLOAK_CONTEXT_COOKIE_DOMAINS="mercor.com"
export AI_BROWSER_HOLDER_PID=$$

park_lease() {
  if [[ -n "$LEASE_TOKEN" && -n "$LEASE_GENERATION" ]]; then
    "$LEASE_PYTHON" "$LEASE_SCRIPT" park "$TASK" \
      --token "$LEASE_TOKEN" --generation "$LEASE_GENERATION" >/dev/null 2>&1 || true
  fi
}
trap park_lease EXIT

"$LEASE_PYTHON" "$LEASE_SCRIPT" acquire "$TASK" "https://work.mercor.com/explore" >"$LEASE_JSON"
chmod 600 "$LEASE_JSON"
MERCOR_CDP_PAGE_WS=$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["ws"])' "$LEASE_JSON")
LEASE_TOKEN=$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["token"])' "$LEASE_JSON")
LEASE_GENERATION=$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["generation"])' "$LEASE_JSON")
export MERCOR_CDP_PAGE_WS MERCOR_CDP_BASE_URL="$CDP"
PYTHONPATH="$ROOT/apps/job-search-loop" "$LEASE_PYTHON" \
  -m job_search_loop.mercor_page_ready \
  --ws "$MERCOR_CDP_PAGE_WS" \
  --output "$STATE_ROOT/page-ready.json"

set +e
RUN_STARTED_AT=$(/bin/date +%s)
AUTH_STATUS=""
read_auth_status() {
  AUTH_STATUS=""
  AUTH_STATUS=$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("status", ""))' \
    "$AUTH_READBACK_JSON" 2>/dev/null) || AUTH_STATUS=""
}
run_auth_readback() {
  PYTHONPATH="$ROOT/apps/job-search-loop" "$LEASE_PYTHON" \
    -m job_search_loop.mercor_auth_readback \
    --ws "$MERCOR_CDP_PAGE_WS" --output "$AUTH_READBACK_JSON"
  local auth_rc=$?
  if (( auth_rc == 0 || auth_rc == 2 )); then
    read_auth_status
  else
    AUTH_STATUS=""
  fi
  return "$auth_rc"
}
run_auth_readback || true
if [[ "$AUTH_STATUS" == "indeterminate" ]]; then
  sleep 1
  run_auth_readback || true
fi
if [[ "$AUTH_STATUS" == "logged_out" ]]; then
  # A fresh context may briefly paint the login shell while Firebase hydrates.
  # Require the same exact login-form signal on a second bounded observation
  # before requesting a new magic link.
  sleep 1
  run_auth_readback || true
fi
if [[ "$AUTH_STATUS" == "logged_out" ]]; then
  PYTHONPATH="$ROOT/apps/job-search-loop" "$LEASE_PYTHON" \
    -m job_search_loop.mercor_email_auth \
    --ws "$MERCOR_CDP_PAGE_WS" --after-epoch "$RUN_STARTED_AT" \
    --profile "$HOME/.config/anicca/job-search/profile.json" --output "$EMAIL_AUTH_JSON"
  email_auth_rc=$?
  if (( email_auth_rc != 0 )); then
    print -u2 "mercor application owner: confirmed logout recovery failed"
    exit 75
  fi
  run_auth_readback || true
fi
if [[ "$AUTH_STATUS" != "authenticated" ]]; then
  print -u2 "mercor application owner: authenticated readback unavailable; no login email requested"
  exit 75
fi
MERCOR_APPLICATION_STATE_ROOT="$STATE_ROOT" JOB_SEARCH_STATE_ROOT="${STATE_ROOT:h:h}" \
  MERCOR_RUN_EARNINGS_SYNC=0 \
  "$ROOT/apps/job-search-loop/scripts/run-mercor.sh"
rc=$?
auth_ok=0
if PYTHONPATH="$ROOT/apps/job-search-loop" "$LEASE_PYTHON" \
  -m job_search_loop.mercor_auth_readback \
  --ws "$MERCOR_CDP_PAGE_WS" --output "$AUTH_READBACK_JSON"; then
  auth_ok=1
fi
if (( auth_ok == 1 )); then
  "$LEASE_PYTHON" "$LEASE_SCRIPT" commit-cookies "$TASK" --domain mercor.com \
    --origin https://work.mercor.com --local-storage-key mercor-auth-store \
    --session-storage-key mercor-session-id --session-storage-key mercor-user-ip \
    --indexeddb firebaseLocalStorageDb/firebaseLocalStorage \
    --token "$LEASE_TOKEN" --generation "$LEASE_GENERATION" >"$WRITEBACK_JSON"
  writeback_rc=$?
else
  [[ -f "$AUTH_READBACK_JSON" ]] || \
    print -r -- '{"status":"indeterminate"}' >"$AUTH_READBACK_JSON"
  print -r -- '{"ok":false,"reason":"authenticated_readback_required"}' >"$WRITEBACK_JSON"
  writeback_rc=0
fi
set -e
chmod 600 "$AUTH_READBACK_JSON" "$WRITEBACK_JSON"
[[ ! -f "$EMAIL_AUTH_JSON" ]] || chmod 600 "$EMAIL_AUTH_JSON"
if (( writeback_rc != 0 && rc == 0 )); then
  rc=75
fi
exit "$rc"
