#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$HOME/.local/share/life-manager/venv/bin/python}"
LOCK_PYTHON="${LIFE_MANAGER_LOCK_PYTHON:-/usr/bin/python3}"
STATE_ROOT="${LIFE_MANAGER_STATE_ROOT:?LIFE_MANAGER_STATE_ROOT is required}"

if [[ ! -x "$PYTHON" ]]; then
  echo "paid-owner: managed Python is unavailable: $PYTHON" >&2
  exit 69
fi

set +e
"$LOCK_PYTHON" "$ROOT/skills/browser/scripts/run_with_file_lock.py" \
  "$STATE_ROOT/provider-browser.lock" -- \
  "$PYTHON" "$ROOT/skills/_shared/marketplace-core/scripts/paid_kernel.py" \
  --provider-adapter "$ROOT/skills/earn/crowdworks/scripts/paid_adapter.py" \
  --state-root "$STATE_ROOT/paid" \
  --output "$STATE_ROOT/paid-latest.json" \
  --max-workers 1 \
  -- \
  --account-id 7145638 \
  --state-path "$STATE_ROOT/paid"
RC=$?
set -e

# A successful Paid wake writes an occurrence-bound zero-effect marker.  Release
# that exact host-admission claim when the marker proves no provider mutation
# was armed; never broaden this to an owner-wide fence clear.
OCCURRENCE="${LIFE_MANAGER_OCCURRENCE_ID:-}"
if [[ -n "$OCCURRENCE" ]]; then
  set +e
  "$PYTHON" "$ROOT/skills/earn/crowdworks/scripts/reconcile_paid_no_effect.py" \
    --state-root "$STATE_ROOT" --occurrence "$OCCURRENCE" --resolve
  RECONCILE_RC=$?
  set -e
  if (( RECONCILE_RC != 0 )); then
    echo "paid-owner: zero-effect occurrence was not reconciled: $OCCURRENCE" >&2
  fi
fi

exit "$RC"
