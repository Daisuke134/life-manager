#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$HOME/.local/share/life-manager/venv/bin/python}"
LOCK_PYTHON="${LIFE_MANAGER_LOCK_PYTHON:-/usr/bin/python3}"
STATE_ROOT="${LIFE_MANAGER_STATE_ROOT:?LIFE_MANAGER_STATE_ROOT is required}"

if [[ ! -x "$PYTHON" ]]; then
  echo "paid-owner: managed Python is unavailable: $PYTHON" >&2
  exit 69
fi

set +e
"$LOCK_PYTHON" "$ROOT/skills/browser/scripts/run_with_file_lock.py" \
  "$STATE_ROOT/provider-browser.lock" -- \
  "$PYTHON" "$ROOT/skills/_shared/marketplace-core/scripts/paid_kernel.py" \
  --provider-adapter "$ROOT/skills/earn/crowdworks/scripts/paid_adapter.py" \
  --state-root "$STATE_ROOT/paid" \
  --output "$STATE_ROOT/paid-latest.json" \
  --max-workers 1 \
  -- \
  --account-id 7145638 \
  --state-path "$STATE_ROOT/paid"
RC=$?
set -e

if [[ "$RC" -ne 0 && -n "${LIFE_MANAGER_RESULT_HINT_PATH:-}" ]]; then
  "$PYTHON" - "$STATE_ROOT/paid-latest.json" "$LIFE_MANAGER_RESULT_HINT_PATH" <<'PY' || true
import json
import os
from pathlib import Path
import sys

try:
    result = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    if (result.get("status") == "failed"
            and result.get("failed_step") == "provider_inventory"
            and result.get("effect") == 0):
        target = Path(sys.argv[2])
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps({"status": "pre_effect_failure", "effect": 0}) + "\n",
                          encoding="utf-8")
        os.chmod(target, 0o600)
except (OSError, TypeError, ValueError, json.JSONDecodeError):
    pass
PY
fi

exit "$RC"
