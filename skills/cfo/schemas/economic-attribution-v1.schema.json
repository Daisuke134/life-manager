              "type": "null"
            }
          ]
        },
        "verification_state": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "pending"
          ]
        },
        "revenue_class": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "one_time",
                "monthly_recurring",
                "other_recurring"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+.-]*://\\S+$"
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "allOf": [
