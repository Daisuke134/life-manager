              "components": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "enum": [
                        "pending_revenue",
                        "payout",
                        "owner_deposit",
                        "self_payment",
                        "internal_transfer",
                        "token_appreciation",
                        "unrealized_investment_pnl",
                        "fundraising"
                      ]
                    }
                  },
                  "required": [
                    "category"
                  ]
                }
              }
            },
            "required": [
              "components"
            ]
          },
          "then": {
            "properties": {
              "components": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "components": {
                "contains": {
                  "type": "object",
