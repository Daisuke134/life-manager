        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+.-]*://\\S+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "normalized_monthly_amount": {
                "type": "string",
                "pattern": "^(?=.*[1-9])(?:0|[1-9]\\d*)(?:\\.\\d{1,18})?$"
              }
            }
          }
        }
      ]
    }
  }
}
