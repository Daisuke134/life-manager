              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "components": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "enum": [
                        "pending_revenue"
                      ]
                    }
                  },
                  "required": [
                    "category"
                  ]
                }
              }
            },
            "required": [
