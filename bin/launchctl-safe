#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PREFLIGHT="$ROOT/skills/_shared/lib/launchd_preflight.py"
PENDING_GUARD="$ROOT/runtime/loop/launchctl_pending_guard.py"
RECEIPT=${LIFE_MANAGER_LAUNCHD_PREFLIGHT_RECEIPT:-"$HOME/.local/state/life-manager/launchd-control-plane-preflight.json"}

if [ "${1:-}" = "preflight" ]; then
  exec /usr/bin/python3 "$PREFLIGHT" --receipt "$RECEIPT"
fi
[ "$#" -gt 0 ] || { echo "usage: launchctl-safe preflight | <launchctl arguments>" >&2; exit 2; }

case "$1" in
  managername|manageruid|managerpid|version|variant|help)
    exec /bin/launchctl "$@"
    ;;
  print|print-disabled)
    case "${2:-}" in
      gui/*)
        /usr/bin/python3 "$PREFLIGHT" --receipt "$RECEIPT" >/dev/null || {
          rc=$?
          echo "launchctl GUI read blocked before unsafe domain access; receipt=$RECEIPT" >&2
          exit "$rc"
        }
        ;;
    esac
    exec /bin/launchctl "$@"
    ;;
  list)
    /usr/bin/python3 "$PREFLIGHT" --receipt "$RECEIPT" >/dev/null || {
      rc=$?
      echo "launchctl list blocked before unsafe bootstrap access; receipt=$RECEIPT" >&2
      exit "$rc"
    }
    exec /bin/launchctl "$@"
    ;;
  *)
    /usr/bin/python3 "$PREFLIGHT" --receipt "$RECEIPT" >/dev/null || {
      rc=$?
      echo "launchctl mutation blocked: invalid Aqua/user bootstrap; receipt=$RECEIPT" >&2
      exit "$rc"
    }
    if [ "$1" = bootout ] && [ "$#" -eq 2 ]; then
      /usr/bin/python3 "$PENDING_GUARD" "$ROOT/config/loop-registry.json" "$2"
    fi
    exec /bin/launchctl "$@"
    ;;
esac
