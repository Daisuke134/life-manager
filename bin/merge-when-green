#!/usr/bin/env bash
# Merge a PR only after every check has finished and none failed (REVIEW.md "Merging").
# 2026-10-17: #8281/#8282 were merged with --admin while a check was still running.
# The head commit seen green is pinned, so a later push cannot merge unverified.
# Usage: bin/merge-when-green <pr> [gh pr merge args...]   (default: --squash --admin)
set -uo pipefail
pr="${1:?usage: merge-when-green <pr> [merge args]}"; shift
[ $# -eq 0 ] && set -- --squash --admin
poll="${MERGE_WHEN_GREEN_POLL:-20}"; tries="${MERGE_WHEN_GREEN_TRIES:-90}"
for _ in $(seq 1 "$tries"); do
  snapshot="$(gh pr view "$pr" --json headRefOid,statusCheckRollup --jq '
    def bucket:
      if .__typename == "CheckRun" then
        if .status != "COMPLETED" then "pending"
        elif .conclusion == "SUCCESS" or .conclusion == "NEUTRAL" or .conclusion == "SKIPPED" then "pass"
        else "fail" end
      elif .__typename == "StatusContext" then
        if .state == "SUCCESS" then "pass"
        elif .state == "PENDING" or .state == "EXPECTED" then "pending"
        else "fail" end
      else "fail" end;
    .headRefOid as $head
    | ((.statusCheckRollup // []) | map(bucket)) as $states
    | [$head, (if ($states | length) == 0 then "none"
               elif ($states | index("fail")) != null then "fail"
               elif ($states | index("pending")) != null then "pending"
               else "green" end)]
    | @tsv
  ' 2>/dev/null)" || snapshot=""
  IFS=$'\t' read -r head state <<< "$snapshot"
  if [ -z "$head" ] || [ -z "$state" ] || [ "$state" = "none" ]; then
    echo "merge-when-green: no checks or head for #$pr (gh error or none registered)" >&2; sleep "$poll"; continue
  fi
  case "$state" in
    fail) echo "merge-when-green: #$pr has a failed check; not merging" >&2; exit 2 ;;
    pending) sleep "$poll"; continue ;;
    green) ;;
    *) echo "merge-when-green: #$pr has an unknown check state '$state'; not merging" >&2; exit 2 ;;
  esac
  # CodeRabbit may pass before GitHub registers the mandatory workflow's jobs.
  workflow="$(gh run list --workflow sec-scan.yml --commit "$head" --event pull_request --limit 1 \
    --json headSha,status,conclusion \
    --jq '.[0] | select(. != null) | "\(.headSha) \(.status) \(.conclusion)"' 2>/dev/null)" || workflow=""
  case "$workflow" in
    "$head completed success") ;;
    "$head completed "*) echo "merge-when-green: #$pr mandatory workflow did not succeed; not merging" >&2; exit 2 ;;
    *) echo "merge-when-green: #$pr waiting for mandatory workflow on $head" >&2; sleep "$poll"; continue ;;
  esac
  exec gh pr merge "$pr" "$@" --match-head-commit "$head"
done
echo "merge-when-green: #$pr checks still running after $tries polls; not merging" >&2
exit 3
